# Rust / Cargo
**/target/
**/*.rs.bk

# Flutter / Dart
**/.dart_tool/
**/build/
**/.packages
**/.pub-cache/
**/.pub/
**/pubspec.lock

# Flutter - Plataforma Android
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/*.keystore
**/android/**/*.jks

# Flutter - Plataforma Linux
**/linux/flutter/ephemeral/

# Modelos LLM y pesos locales
*.gguf
*.bin
models/

# Entorno y credenciales
.env
*.local

# Editores y sistema operativo
.vscode/
.antigravity/
.idea/
*.swp
*.swo
*~
.DS_Store

# Personal
old*

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Flutter y Dart (generados en tiempo de build)
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/linux/flutter/ephemeral/

# Android (generados por Gradle/NDK)
app/android/.gradle/
app/android/local.properties
app/android/app/build/
app/android/app/src/main/jniLibs/

# Artefactos duplicados de Flutter (evita subir 180 MB y superar el límite de 100 MB de GitHub)
app/assets/data/
app/assets/models/
